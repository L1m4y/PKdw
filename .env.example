# Copy this file to .env next to the pkdw executable.
# The token is a single-use refresh token copied from the PikPak web app.
#
# PIKPAK_REFRESH_TOKEN=os.replace_me
#
# Optional: a stable device id. pkdw creates one automatically on first run.
# PIKPAK_DEVICE_ID=
#
# Optional: HTTP/SOCKS proxy, for example http://127.0.0.1:8080
# PIKPAK_PROXY=
